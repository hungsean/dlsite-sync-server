PORT=3000
# 允許的前端來源, 逗號分隔
CORS_ORIGIN=http://localhost:5173
# SQLite 檔案路徑
DATABASE_PATH=./data/app.db
# 從 DLsite 下載的作品檔案存放目錄
DOWNLOAD_DIR=./data/downloads
# 解壓縮時 zip 檔名沒標 UTF-8 flag 時的後備編碼 (DLsite 多為日文 shift_jis; 繁中可設 big5, 簡中 gbk)
ZIP_FALLBACK_ENCODING=shift_jis
# 加密資料庫裡 DLsite 密碼用的金鑰, 至少 32 字元 (可用 openssl rand -base64 32 產生)
APP_SECRET=change-me-please-at-least-32-characters
